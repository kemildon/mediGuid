# ==============================================================================
# MediGuid Healthcare Workstation - Environment Configuration
# ==============================================================================

# Backend Server Port
PORT=5000

# Database Connection (SQLite default, PostgreSQL optional via postgres://...)
DATABASE_URL=sqlite:./data/mediguid.db

# ==============================================================================
# Meta WhatsApp Business Platform / Cloud API Credentials
# Official Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
# ==============================================================================
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=mediguid_webhook_token_2026
META_APP_SECRET=

# ==============================================================================
# AI & Voice Services (Optional - Clinical Parser works with high-precision regex/NLP)
# ==============================================================================
AI_API_KEY=
TTS_API_KEY=
